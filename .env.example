# --- IA: llena UNA. Si hay varias, se usa en este orden: OpenRouter, Gemini, Claude ---
# OpenRouter: https://openrouter.ai/keys  (modelos: https://openrouter.ai/models)
OPENROUTER_API_KEY=
OPENROUTER_MODELO=openai/gpt-5.6-luna
# Voz con OpenRouter. Vacío = no usar. Modelos de voz: https://openrouter.ai/models?output_modalities=speech
# Probados: openai/gpt-audio-mini (acento peruano por instrucciones) y fish-audio/s2.1-pro-free:free (gratis)
OPENROUTER_VOZ_MODELO=openai/gpt-audio-mini
# Voz: para gpt-audio: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar (vacío = coral).
# Para Fish Audio: ID de una voz de fish.audio (vacío = la del modelo)
OPENROUTER_VOZ=
# Respaldo (texto a voz puro) por si gpt-audio no lee el texto tal cual. Vacío = sin respaldo
OPENROUTER_VOZ_RESPALDO=fish-audio/s2.1-pro-free:free
# Gemini (gratis con límites): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODELO=gemini-2.5-flash
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# --- Obligatorio para el LIVE real ---
# Usuario de TikTok que está EN VIVO (sin @)
TIKTOK_USUARIO=tu_usuario
# Opcional: clave gratuita de https://www.eulerstream.com si la conexión al chat falla con error 403
EULER_API_KEY=

# --- Opcional: voz con ElevenLabs (se usa si no hay voz de OpenRouter; si tampoco, la del navegador) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODELO=eleven_multilingual_v2

# --- Ajustes ---
CLAUDE_MODELO=claude-haiku-4-5-20251001
PORT=3000
# Música de fondo: pon tus MP3 libres de derechos en public/musica (vacía = sin música)
# Volumen de 0 a 1, normal y mientras Doña Chabela habla
MUSICA_VOLUMEN=0.25
MUSICA_VOLUMEN_HABLANDO=0.06
# Segundos que un mismo usuario debe esperar para que su comentario sea respondido otra vez
COOLDOWN_USUARIO=20
# Máximo de comentarios en espera; si se llena, sale el menos interesante
MAX_COLA=5
# Segundos que un comentario puede esperar; si pasa más, se descarta para no responder tarde
CADUCIDAD_SEGUNDOS=30
# Tope de respuestas por minuto (controla el gasto aunque el chat explote). 0 = sin tope
MAX_RESPUESTAS_MINUTO=8
# Ahorro de voz (Gemini TTS cobra por segundo de audio):
# largo máximo de cada respuesta, en palabras (antes 25)
MAX_PALABRAS=15
# tap tap, compartir, ranking, likes y saludos con frases fijas ya grabadas (sin IA): true / false
FRASES_FIJAS=true
# guardar el audio para no pagar dos veces la misma frase (datos/voz-cache): true / false
CACHE_VOZ=true
LIKES_PARA_REACCION=300
# Cada cuántos minutos Doña Chabela pide tap tap a la pantalla (0 = nunca)
PEDIR_TAPS_MINUTOS=8
# Cuando dos personas conversan entre sí (@usuario), Doña Chabela se mete con humor como mucho
# una vez cada estos segundos; las demás conversaciones se ignoran
CHISME_CADA_SEGUNDOS=120
# Saluda a los que entran al LIVE (juntos en una frase) como mucho una vez cada estos segundos. 0 = no saludar
SALUDO_CADA_SEGUNDOS=45
# Si hay poco movimiento (menos de estos comentarios en 2 minutos), la tía saluda a cada uno por su nombre,
# corto y con una pregunta, como mucho uno cada SALUDO_RAPIDO_SEGUNDOS
POCO_MOVIMIENTO_COMENTARIOS=6
SALUDO_RAPIDO_SEGUNDOS=10
# Cada cuántos minutos pide que compartan el LIVE (0 = nunca)
COMPARTIR_CADA_MINUTOS=10
# Cada cuántos minutos anuncia (y muestra) el ranking de caseritos (0 = nunca)
RANKING_CADA_MINUTOS=7
# Puntos del ranking: comentario, cada cuántos tap tap es un punto, compartir, cada regalo
# (+1 por cada diamante que vale el regalo si PUNTOS_POR_DIAMANTE=true
# Si nadie comenta en estos segundos, Doña Chabela pregunta algo, cuenta un chisme o un chiste (0 = nunca)
SILENCIO_SEGUNDOS=45
# Si el chat está callado, en vez de hablar sola lanza juegos (dibujo y trivia; a veces un chiste o chisme): true / false
JUEGOS_EN_SILENCIO=true
# Meta de tap tap en pantalla: al llegar, la tía baila y la meta sube otro tanto (0 = sin meta)
META_LIKES=5000
# El chat pide preguntas escribiendo TRIVIA, ENCUESTA, PREGUNTA o JUGAR. Espera mínima entre una y otra (segundos)
JUEGO_COOLDOWN_SEGUNDOS=45
# Encuestas automáticas cada cuántos minutos (0 = solo cuando el chat las pide) y cuánto dura cada una
ENCUESTA_CADA_MINUTOS=0
ENCUESTA_SEGUNDOS=60
# Trivia automática cada cuántos minutos (0 = solo cuando el chat la pide) y segundos para responder
TRIVIA_CADA_MINUTOS=0
TRIVIA_SEGUNDOS=30
# La tía dibuja (el chat escribe DIBUJO): segundos para adivinar y cada cuántos minutos sale solo (0 = solo si lo piden)
DIBUJO_SEGUNDOS=45
DIBUJO_CADA_MINUTOS=0
# Puntos del dibujo y la trivia: podio de 3 al terminar el tiempo (1.º todo, 2.º 60 %, 3.º 40 %).
# Puntos del 1.º que adivina el dibujo, y de los demás que también adivinan
PUNTOS_DIBUJO_MAX=20
PUNTOS_DIBUJO_RESTO=2
# Cada LIVE nuevo empieza en cero: se borran caseritos, mensajes, pedidos y puntos (queda copia en datos/respaldos).
# Es LIVE nuevo si pasaron más de estas horas desde la última actividad; si reinicias a mitad del LIVE, no se borra nada
NUEVO_LIVE_HORAS=2
# Puntos de trivia para el primero que acierta, según dificultad, y para los demás que aciertan
PUNTOS_TRIVIA_FACIL=5
PUNTOS_TRIVIA_INTERMEDIO=10
PUNTOS_TRIVIA_DIFICIL=20
PUNTOS_TRIVIA_ACIERTO=2
PUNTOS_COMENTARIO=1
TAPS_POR_PUNTO=20
PUNTOS_COMPARTIR=3
PUNTOS_REGALO=10
PUNTOS_POR_DIAMANTE=true
# Memoria: recuerda a los caseritos entre LIVEs (se guarda en datos/chabela.db). false = no recordar
MEMORIA=true
# Juego de pedidos (cocina de mentira): cuánto tarda un pedido en salir, en minutos
JUEGO_PEDIDOS=true
PEDIDO_MINUTOS_MIN=2
PEDIDO_MINUTOS_MAX=4
# Personajes bailando en el piso: true = siempre; false = solo un rato con regalos, likes o cada SHOW_CADA_MINUTOS
BAILE_SIEMPRE=true
# Modo liviano: apaga los efectos que más cargan la PC (tinte de discoteca, manchas de luz, baile permanente...)
# para que la transmisión se vea fluida en HD. Los juegos, las celebraciones y la tía siguen igual: true / false
MODO_LIVIANO=false
# Cada cuántos minutos cambia el grupo que baila (con BAILE_SIEMPRE=false: cada cuánto sale un show). 0 = nunca
SHOW_CADA_MINUTOS=3

# Voz por link para el cliente (por túnel de Cloudflare). Va en el .env de CADA cliente; genera una con: npm run clave
CLAVE_ACCESO=
PORT_PUBLICO=3100
